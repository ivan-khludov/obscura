{
  "bbr_profile": "standard",
  "initial_packet_size": 1200,
  "listen": "0.0.0.0",
  "listen_port": 443,
  "realm": {
    "realm_id": "my-realm",
    "server_url": "https://realm.example.com",
    "stun_servers": [
      "stun.l.google.com:19302"
    ],
    "token": "token"
  },
  "tag": "vpn-main",
  "tls": {
    "alpn": [
      "h3"
    ],
    "certificate_path": "/etc/obscura/certs/vpn-main.crt",
    "enabled": true,
    "key_path": "/etc/obscura/certs/vpn-main.key",
    "server_name": "example.com"
  },
  "type": "hysteria2",
  "users": [
    {
      "name": "phone",
      "password": "secret"
    }
  ]
}
