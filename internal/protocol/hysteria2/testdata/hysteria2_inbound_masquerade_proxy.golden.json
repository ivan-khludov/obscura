{
  "listen": "0.0.0.0",
  "listen_port": 443,
  "masquerade": {
    "rewrite_host": true,
    "type": "proxy",
    "url": "http://127.0.0.1:8080"
  },
  "tag": "vpn-main",
  "tls": {
    "alpn": [
      "h3"
    ],
    "certificate_path": "/etc/obscura/certs/vpn-main.crt",
    "enabled": true,
    "key_path": "/etc/obscura/certs/vpn-main.key",
    "server_name": "example.com"
  },
  "type": "hysteria2",
  "users": [
    {
      "name": "phone",
      "password": "secret"
    }
  ]
}
